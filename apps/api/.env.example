# Reference of every variable the API understands (validated in src/config/env.schema.ts).
# Load order (first wins; real environment variables always win over files):
#   .env.<NODE_ENV>.local -> .env.<NODE_ENV> -> .env
NODE_ENV=development
PORT=9999
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Swagger UI at /docs. Defaults to true outside production, false in production.
SWAGGER_ENABLED=true
# Public origin of this API as providers reach it. The Console shows
# <PUBLIC_BASE_URL>/api/webhooks/<gatewayId> as each gateway's Callback URL.
# Defaults to http://localhost:<PORT>.
PUBLIC_BASE_URL=http://localhost:9999
# Public origin of the Console, for the links in emails (Password Reset).
# Defaults to http://localhost:8888.
CONSOLE_BASE_URL=http://localhost:8888
DATABASE_URL=postgresql://paybridge:paybridge@localhost:5432/paybridge?schema=public
# BullMQ on Redis. Jobs are dispatch only and can be rebuilt from PostgreSQL.
REDIS_URL=redis://localhost:6379
# Prefix of every BullMQ key (no ':'). Defaults to paybridge.
QUEUE_PREFIX=paybridge
# Most Payments the expiry sweep (every minute) queues per run. Defaults to 100.
EXPIRY_SWEEP_BATCH_SIZE=100
# Most provider queries per second the expiry worker makes. Defaults to 5.
EXPIRY_QUERY_RATE_PER_SECOND=5
# Outbox relay: poll loop toggle (default: on except NODE_ENV=test), pause
# between polls in ms (default 1000) and rows per query (default 100).
OUTBOX_RELAY_ENABLED=true
OUTBOX_RELAY_POLL_INTERVAL_MS=1000
OUTBOX_RELAY_BATCH_SIZE=100
# Stripe Gateway Plugin: set all three (test keys with test keys, live with live) or none.
# Secret key (sk_ or rk_), webhook signing secret (whsec_) and publishable key (pk_).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Access-token signing key: an ES256 (P-256) PKCS#8 PEM, newlines written as \n.
# Generate: openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt
# Unset in development/tests => a fresh key per start (everyone is signed out on restart).
# Required in production.
AUTH_JWT_PRIVATE_KEY=
# Key rotation: public keys (SPKI PEM, \n for newlines, comma separated) of the previous signing
# keys. They stay in the JWKS and still verify tokens, so nobody is signed out. Drop them once the access-token lifetime (5 minutes) has passed.
AUTH_JWT_RETIRED_PUBLIC_KEYS=

# Keys that encrypt Gateway Connection credentials: id:base64key pairs, comma separated,
# each key 32 random bytes (openssl rand -base64 32). The first encrypts; all decrypt.
# Unset in development/tests => a fixed development key. Required in production.
# Rotate: prepend a new key, then run `pnpm gateway:reencrypt`.
GATEWAY_CREDENTIAL_KEYS=

# Embedded Checkout: starting checkout Payments is rate-limited per Publishable Key and per client IP
# (fixed windows in Redis). Behind a load balancer set TRUST_PROXY (hop count, true, or subnets)
# so the client IP is the browser's.
CHECKOUT_START_RATE_LIMIT_PER_KEY=120
CHECKOUT_START_RATE_LIMIT_PER_IP=20
CHECKOUT_START_RATE_LIMIT_WINDOW_SECONDS=60
TRUST_PROXY=

# Embedded Checkout (ticket 09): origins the checkout app (apps/checkout) is served from,
# comma separated. Its iframe page calls /api/checkout/* from there for the host page it names.
# Unset => http://localhost:3200 outside production, none in production.
CHECKOUT_APP_ORIGINS=
