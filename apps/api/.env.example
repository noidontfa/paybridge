# Reference of every variable the API understands (validated in src/config/env.schema.ts).
# Load order (first wins; real environment variables always win over files):
#   .env.<NODE_ENV>.local -> .env.<NODE_ENV> -> .env
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Swagger UI at /docs. Defaults to true outside production, false in production.
SWAGGER_ENABLED=true
DATABASE_URL=postgresql://paybridge:paybridge@localhost:5432/paybridge?schema=public
# BullMQ on Redis. Jobs are dispatch only and can be rebuilt from PostgreSQL.
REDIS_URL=redis://localhost:6379
# Prefix of every BullMQ key (no ':'). Defaults to paybridge.
QUEUE_PREFIX=paybridge
# Most Payments the expiry sweep (every minute) queues per run. Defaults to 100.
EXPIRY_SWEEP_BATCH_SIZE=100
