# Copy to .env.production for a bare-metal deploy, or - preferably - inject these
# as real environment variables (Docker/Kubernetes/secret manager). Never commit secrets.
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
SWAGGER_ENABLED=false
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/paybridge?schema=public
REDIS_URL=redis://:PASSWORD@HOST:6379
# Stripe Gateway Plugin: set all three (live keys together) or none.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Public origin of this API as providers reach it. The Console shows
# <PUBLIC_BASE_URL>/api/webhooks/<gatewayId> as each gateway's Callback URL.
# Defaults to http://localhost:<PORT>.
PUBLIC_BASE_URL=https://api.example.com

# Access-token signing key: an ES256 (P-256) PKCS#8 PEM, newlines written as \n.
# Generate: openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt
# Unset in development/tests => a fresh key per start (everyone is signed out on restart).
# Required in production.
AUTH_JWT_PRIVATE_KEY=
