# Used by vitest (NODE_ENV=test). Unit and e2e suites need no real database.
# Integration tests (pnpm test:int) use this server with the database named by
# TEST_DATABASE_NAME (default paybridge_test), recreated on every run.
NODE_ENV=test
PORT=3001
LOG_LEVEL=silent
SWAGGER_ENABLED=false
DATABASE_URL=postgresql://paybridge:paybridge@localhost:5432/paybridge_test?schema=public
