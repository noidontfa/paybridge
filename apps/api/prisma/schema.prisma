// PayBridge database schema.
// Docs: https://www.prisma.io/docs/orm/prisma-schema
//
// Conventions (spec: PostgreSQL schema; ADR 0001):
// - Every table and enum type is mapped to a prefixed name: `core_` for Payment
//   Core, `iam_` for the Identity module (ADR 0001). src/database/schema.spec.ts
//   enforces the prefix and the partial indexes.
// - Every `core_*` table that holds Organization data has a non-null
//   `organization_id` foreign key to `iam_organizations` (ADR 0006).
// - Ids are UUID v7 generated by the application (no database default).
// - Timestamps are timestamptz with millisecond precision.
// - Columns are snake_case (@map); model and field names are camelCase.
// - Foreign keys are ON DELETE RESTRICT and ON UPDATE RESTRICT: nothing cascades.
// - `amount > 0` checks live as raw SQL in the init migration (Prisma cannot
//   declare CHECK constraints and does not report them as drift).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum PaymentStatus {
  PENDING
  SUCCEEDED
  CANCELLED
  EXPIRED

  @@map("core_payment_status")
}

enum PaymentTransactionStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  CANCELLED
  REQUIRES_REVIEW

  @@map("core_payment_transaction_status")
}

enum ReviewReason {
  AMBIGUOUS_PROVIDER_STATUS
  AMOUNT_MISMATCH
  LATE_SUCCESS_ON_CLOSED_PAYMENT
  DUPLICATE_SUCCESS

  @@map("core_review_reason")
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  REQUIRES_ACTION
  CANCELLED

  @@map("core_refund_status")
}

enum GatewayOperation {
  initiate
  query
  cancel

  @@map("core_gateway_operation")
}

enum OutboxEventType {
  PaymentCreated
  PaymentSucceeded
  PaymentCancelled
  PaymentExpired
  PaymentRequiresReview

  @@map("core_outbox_event_type")
}

enum WebhookInboxStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED

  @@map("core_webhook_inbox_status")
}

enum StatusTransitionEntityType {
  PAYMENT
  PAYMENT_TRANSACTION
  REFUND

  @@map("core_status_transition_entity_type")
}

// ---------------------------------------------------------------------------
// Identity: Organizations (owned by the identity module, `iam_` prefix)
// ---------------------------------------------------------------------------

enum OrganizationStatus {
  ACTIVE
  SUSPENDED

  @@map("iam_organization_status")
}

/// The tenant. Never deleted, only suspended.
model Organization {
  id        String             @id @db.Uuid
  name      String
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  payments            Payment[]
  paymentTransactions PaymentTransaction[]
  refunds             Refund[]
  gatewayRawResponses GatewayRawResponse[]
  idempotencyKeys     IdempotencyKey[]
  outboxEvents        OutboxEvent[]
  webhookInbox        WebhookInbox[]
  statusTransitions   StatusTransition[]

  @@map("iam_organizations")
}

// ---------------------------------------------------------------------------
// Payment aggregate
// ---------------------------------------------------------------------------

model Payment {
  id              String        @id @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  /// Upstream Reference: unique within an Organization, immutable.
  merchantOrderId String        @map("merchant_order_id")
  /// Major unit of the currency (whole dong for VND). CHECK amount > 0 in SQL.
  amount          Decimal       @db.Decimal(19, 4)
  /// ISO 4217 code. VND only in Phase 1 (enforced by validation).
  currency        String        @db.Char(3)
  status          PaymentStatus
  expiresAt       DateTime      @map("expires_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  transactions    PaymentTransaction[]
  idempotencyKeys IdempotencyKey[]
  outboxEvents    OutboxEvent[]

  @@unique([organizationId, merchantOrderId], map: "core_payments_org_merchant_order_id_uq")
  @@index([status, expiresAt], map: "core_payments_pending_expiry_idx", where: { status: "PENDING" })
  /// Operator Payments list: keyset paging by creation time or amount (id is the tiebreaker), inside one Organization.
  @@index([organizationId, createdAt, id], map: "core_payments_org_created_at_id_idx")
  @@index([organizationId, amount, id], map: "core_payments_org_amount_id_idx")
  @@map("core_payments")
}

/// One attempt to collect a Payment through one gateway. `id` is the Attempt Key.
model PaymentTransaction {
  id               String                   @id @db.Uuid
  organizationId   String                   @map("organization_id") @db.Uuid
  paymentId        String                   @map("payment_id") @db.Uuid
  /// Gateway identifier: plain text, not an enum. Never changes.
  gatewayId        String                   @map("gateway_id")
  status           PaymentTransactionStatus
  /// Provider Reference: set once, immutable.
  providerRef      String?                  @map("provider_ref")
  /// Opaque to Core; passed back to the plugin on later calls.
  providerMetadata Json?                    @map("provider_metadata")
  nextAction       Json?                    @map("next_action")
  reviewReason     ReviewReason?            @map("review_reason")
  reviewOpenedAt   DateTime?                @map("review_opened_at") @db.Timestamptz(3)
  refundRequired   Boolean                  @default(false) @map("refund_required")
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  payment      Payment              @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  refunds      Refund[]
  rawResponses GatewayRawResponse[]

  @@unique([gatewayId, providerRef], map: "core_payment_transactions_gateway_provider_ref_uq")
  /// Invariant 6a: at most one open (CREATED or PENDING) attempt per Payment.
  @@unique([paymentId], map: "core_payment_transactions_one_open_uq", where: raw("(status = ANY (ARRAY['CREATED'::core_payment_transaction_status, 'PENDING'::core_payment_transaction_status]))"))
  /// Invariant 7: at most one SUCCEEDED attempt per Payment.
  @@unique([paymentId], map: "core_payment_transactions_one_succeeded_uq", where: { status: "SUCCEEDED" })
  @@index([paymentId], map: "core_payment_transactions_payment_id_idx")
  /// Operator Payments list: latest attempt of a Payment, and the gateway filter.
  @@index([paymentId, createdAt, id], map: "core_payment_transactions_payment_created_idx")
  @@index([gatewayId, paymentId], map: "core_payment_transactions_gateway_payment_idx")
  /// Operator Reviews list: keyset paging by the time the Review opened, inside one Organization.
  @@index([organizationId, reviewOpenedAt, id], map: "core_payment_transactions_org_review_opened_idx")
  @@map("core_payment_transactions")
}

/// Fields only in Phase 1: there is no write path. `id` is the refund key.
model Refund {
  id               String       @id @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  attemptId        String       @map("attempt_id") @db.Uuid
  /// CHECK amount > 0 in SQL.
  amount           Decimal      @db.Decimal(19, 4)
  status           RefundStatus
  providerRef      String?      @map("provider_ref")
  providerMetadata Json?        @map("provider_metadata")
  reason           String?
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attempt      PaymentTransaction @relation(fields: [attemptId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, id], map: "core_refunds_org_id_idx")
  @@index([attemptId], map: "core_refunds_attempt_id_idx")
  @@map("core_refunds")
}

// ---------------------------------------------------------------------------
// Infrastructure tables
// ---------------------------------------------------------------------------

/// Raw provider payloads, stored and never interpreted by Core.
model GatewayRawResponse {
  id             String           @id @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  attemptId      String           @map("attempt_id") @db.Uuid
  operation      GatewayOperation
  payload        Json
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attempt      PaymentTransaction @relation(fields: [attemptId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([attemptId, createdAt], map: "core_gateway_raw_responses_attempt_created_idx")
  @@map("core_gateway_raw_responses")
}

/// Idempotency-Key records for POST /payments (kept 24 hours). A key is
/// unique within an Organization, so two Organizations never share a record.
model IdempotencyKey {
  organizationId String   @map("organization_id") @db.Uuid
  key            String   @db.VarChar(255)
  requestHash    String   @map("request_hash")
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  paymentId      String?  @map("payment_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  payment      Payment?     @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([organizationId, key])
  @@index([expiresAt], map: "core_idempotency_keys_expires_at_idx")
  @@map("core_idempotency_keys")
}

/// Transactional outbox of Payment-level events. `id` is also the BullMQ job id.
model OutboxEvent {
  id             String          @id @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  eventType      OutboxEventType @map("event_type")
  paymentId      String          @map("payment_id") @db.Uuid
  payload        Json
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt    DateTime?       @map("published_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  payment      Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([id], map: "core_outbox_events_unpublished_idx", where: raw("(published_at IS NULL)"))
  @@index([publishedAt], map: "core_outbox_events_published_at_idx")
  @@index([organizationId, createdAt, id], map: "core_outbox_events_org_created_at_id_idx")
  @@map("core_outbox_events")
}

/// Verified gateway callbacks, stored before processing.
model WebhookInbox {
  id              String             @id @db.Uuid
  organizationId  String             @map("organization_id") @db.Uuid
  gatewayId       String             @map("gateway_id")
  /// Provider event id when present, otherwise SHA-256 of the raw body.
  dedupeKey       String             @map("dedupe_key")
  providerEventId String?            @map("provider_event_id")
  /// No foreign key: a callback may name an attempt Core does not know.
  attemptKey      String?            @map("attempt_key") @db.Uuid
  rawBody         Bytes              @map("raw_body")
  /// Allow-listed per plugin.
  headers         Json
  query           Json
  status          WebhookInboxStatus @default(RECEIVED)
  attempts        Int                @default(0)
  lockedAt        DateTime?          @map("locked_at") @db.Timestamptz(3)
  lastError       String?            @map("last_error")
  receivedAt      DateTime           @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt     DateTime?          @map("processed_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, gatewayId, dedupeKey], map: "core_webhook_inbox_org_gateway_dedupe_uq")
  @@index([lockedAt], map: "core_webhook_inbox_processing_locked_idx", where: { status: "PROCESSING" })
  @@index([receivedAt], map: "core_webhook_inbox_pending_received_idx", where: raw("(status = ANY (ARRAY['RECEIVED'::core_webhook_inbox_status, 'FAILED'::core_webhook_inbox_status]))"))
  @@index([organizationId, receivedAt, id], map: "core_webhook_inbox_org_received_at_idx")
  @@index([attemptKey], map: "core_webhook_inbox_attempt_key_idx")
  @@map("core_webhook_inbox")
}

/// Append-only audit trail, written in the same transaction as the change.
model StatusTransition {
  id             String                     @id @db.Uuid
  organizationId String                     @map("organization_id") @db.Uuid
  entityType     StatusTransitionEntityType @map("entity_type")
  entityId       String                     @map("entity_id") @db.Uuid
  /// Null when the entity is created.
  fromStatus     String?                    @map("from_status")
  toStatus       String                     @map("to_status")
  trigger        String
  actor          String
  reason         String?
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([entityType, entityId, createdAt], map: "core_status_transitions_entity_idx")
  @@index([organizationId, createdAt, id], map: "core_status_transitions_org_created_at_id_idx")
  @@map("core_status_transitions")
}
