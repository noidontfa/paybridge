// PayBridge database schema.
// Docs: https://www.prisma.io/docs/orm/prisma-schema
//
// Conventions (spec: PostgreSQL schema; ADR 0001):
// - Every table and enum type is mapped to a prefixed name: `core_` for Payment
//   Core, `iam_` for the Identity module, `chk_` for the checkout module,
//   `wh_` for Webhooks (ADR 0001). src/database/schema.spec.ts
//   enforces the prefix and the partial indexes.
// - Every `core_*` table that holds Organization data has a non-null
//   `organization_id` foreign key to `iam_organizations` (ADR 0006).
// - Ids are UUID v7 generated by the application (no database default).
// - Timestamps are timestamptz with millisecond precision.
// - Columns are snake_case (@map); model and field names are camelCase.
// - Foreign keys are ON DELETE RESTRICT and ON UPDATE RESTRICT: nothing cascades.
// - `amount > 0` checks live as raw SQL in the init migration (Prisma cannot
//   declare CHECK constraints and does not report them as drift).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum PaymentStatus {
  PENDING
  SUCCEEDED
  CANCELLED
  EXPIRED

  @@map("core_payment_status")
}

enum PaymentTransactionStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  CANCELLED
  REQUIRES_REVIEW

  @@map("core_payment_transaction_status")
}

enum ReviewReason {
  AMBIGUOUS_PROVIDER_STATUS
  AMOUNT_MISMATCH
  LATE_SUCCESS_ON_CLOSED_PAYMENT
  DUPLICATE_SUCCESS

  @@map("core_review_reason")
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  REQUIRES_ACTION
  CANCELLED

  @@map("core_refund_status")
}

enum GatewayOperation {
  initiate
  query
  cancel

  @@map("core_gateway_operation")
}

enum OutboxEventType {
  PaymentCreated
  PaymentSucceeded
  PaymentCancelled
  PaymentExpired
  PaymentRequiresReview

  @@map("core_outbox_event_type")
}

enum WebhookInboxStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED

  @@map("core_webhook_inbox_status")
}

enum StatusTransitionEntityType {
  PAYMENT
  PAYMENT_TRANSACTION
  REFUND

  @@map("core_status_transition_entity_type")
}

// ---------------------------------------------------------------------------
// Identity: Organizations (owned by the identity module, `iam_` prefix)
// ---------------------------------------------------------------------------

enum OrganizationStatus {
  ACTIVE
  SUSPENDED

  @@map("iam_organization_status")
}

/// The tenant. Never deleted, only suspended.
model Organization {
  id        String             @id @db.Uuid
  name      String
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  payments            Payment[]
  paymentTransactions PaymentTransaction[]
  refunds             Refund[]
  gatewayRawResponses GatewayRawResponse[]
  idempotencyKeys     IdempotencyKey[]
  outboxEvents        OutboxEvent[]
  webhookInbox        WebhookInbox[]
  statusTransitions   StatusTransition[]
  gatewayConnections  GatewayConnection[]
  users               User[]
  invitations         Invitation[]
  apiKeys             ApiKey[]
  pricingPlans        PricingPlan[]
  webhookEndpoints    WebhookEndpoint[]
  webhookDeliveries   WebhookDelivery[]
  webhookAttempts     WebhookDeliveryAttempt[]
  webhookSecretRolls  WebhookSecretRoll[]
  publishableKeys     PublishableKey[]
  pricingTables       PricingTable[]
  pricingTablePlans   PricingTablePlan[]

  @@map("iam_organizations")
}

enum UserRole {
  SUPER_ADMIN
  ORGANIZATION_ADMIN
  OPERATOR

  @@map("iam_user_role")
}

/// A person who signs in to the Console. A Super Admin has no Organization
/// (enforced by a check constraint in the migration).
model User {
  id             String   @id @db.Uuid
  email          String   @unique
  name           String
  passwordHash   String   @map("password_hash")
  role           UserRole
  organizationId String?  @map("organization_id") @db.Uuid
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization?  @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]

  @@index([organizationId], map: "iam_users_organization_id_idx")
  @@map("iam_users")
}

/// A refresh token, stored hashed. Tokens of one sign-in form a family.
model RefreshToken {
  id          String    @id @db.Uuid
  familyId    String    @map("family_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Absolute lifetime: 7 days from sign-in, carried over on rotation.
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Idle lifetime: 24 hours from this token's creation.
  idleExpiresAt DateTime @map("idle_expires_at") @db.Timestamptz(3)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([familyId], map: "iam_refresh_tokens_family_id_idx")
  @@index([userId], map: "iam_refresh_tokens_user_id_idx")
  @@map("iam_refresh_tokens")
}

/// A Password Reset link, stored hashed. Single-use, valid for 30 minutes.
model PasswordReset {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([userId], map: "iam_password_resets_user_id_idx")
  @@map("iam_password_resets")
}

/// An Invitation to join: an email, a Role and an Organization (none for a
/// Super Admin). Stored hashed, single-use, valid for 7 days. Re-sending
/// replaces the hash, which voids the previous link.
model Invitation {
  id             String    @id @db.Uuid
  email          String
  role           UserRole
  organizationId String?   @map("organization_id") @db.Uuid
  invitedById    String?   @map("invited_by_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId], map: "iam_invitations_organization_id_idx")
  @@index([email], map: "iam_invitations_email_idx")
  @@map("iam_invitations")
}

/// An Organization's credential for the public payments API, stored as a
/// SHA-256 hash plus a recognisable prefix. The full key is shown only once.
model ApiKey {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  label          String
  prefix         String
  keyHash        String    @unique @map("key_hash")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt     DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId], map: "iam_api_keys_organization_id_idx")
  @@map("iam_api_keys")
}

/// A public key for Customers' browsers on the Organization's allowed
/// websites; it works only on the checkout endpoints (ADR 0009). Not secret,
/// so it is stored in clear and shown again at any time. The writer of each
/// change is kept on the row (a Super Admin shows as the platform).
model PublishableKey {
  id              String    @id @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  label           String
  key             String    @unique
  allowedOrigins  String[]  @map("allowed_origins")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @map("updated_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdByRole   String?   @map("created_by_role")
  createdByName   String?   @map("created_by_name")
  updatedByUserId String?   @map("updated_by_user_id") @db.Uuid
  updatedByRole   String?   @map("updated_by_role")
  updatedByName   String?   @map("updated_by_name")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId], map: "iam_publishable_keys_organization_id_idx")
  @@map("iam_publishable_keys")
}

// ---------------------------------------------------------------------------
// Payment aggregate
// ---------------------------------------------------------------------------

model Payment {
  id              String        @id @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  /// Upstream Reference: unique within an Organization, immutable.
  merchantOrderId String        @map("merchant_order_id")
  /// Major unit of the currency (whole dong for VND). CHECK amount > 0 in SQL.
  amount          Decimal       @db.Decimal(19, 4)
  /// ISO 4217 code. VND only in Phase 1 (enforced by validation).
  currency        String        @db.Char(3)
  status          PaymentStatus
  expiresAt       DateTime      @map("expires_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  transactions    PaymentTransaction[]
  idempotencyKeys IdempotencyKey[]
  outboxEvents    OutboxEvent[]

  @@unique([organizationId, merchantOrderId], map: "core_payments_org_merchant_order_id_uq")
  @@index([status, expiresAt], map: "core_payments_pending_expiry_idx", where: { status: "PENDING" })
  /// Operator Payments list: keyset paging by creation time or amount (id is the tiebreaker), inside one Organization.
  @@index([organizationId, createdAt, id], map: "core_payments_org_created_at_id_idx")
  @@index([organizationId, amount, id], map: "core_payments_org_amount_id_idx")
  @@map("core_payments")
}

/// One attempt to collect a Payment through one gateway. `id` is the Attempt Key.
model PaymentTransaction {
  id               String                   @id @db.Uuid
  organizationId   String                   @map("organization_id") @db.Uuid
  paymentId        String                   @map("payment_id") @db.Uuid
  /// Gateway identifier: plain text, not an enum. Never changes.
  gatewayId        String                   @map("gateway_id")
  status           PaymentTransactionStatus
  /// Provider Reference: set once, immutable.
  providerRef      String?                  @map("provider_ref")
  /// Opaque to Core; passed back to the plugin on later calls.
  providerMetadata Json?                    @map("provider_metadata")
  nextAction       Json?                    @map("next_action")
  reviewReason     ReviewReason?            @map("review_reason")
  reviewOpenedAt   DateTime?                @map("review_opened_at") @db.Timestamptz(3)
  refundRequired   Boolean                  @default(false) @map("refund_required")
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  payment      Payment              @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  refunds      Refund[]
  rawResponses GatewayRawResponse[]

  @@unique([gatewayId, providerRef], map: "core_payment_transactions_gateway_provider_ref_uq")
  /// Invariant 6a: at most one open (CREATED or PENDING) attempt per Payment.
  @@unique([paymentId], map: "core_payment_transactions_one_open_uq", where: raw("(status = ANY (ARRAY['CREATED'::core_payment_transaction_status, 'PENDING'::core_payment_transaction_status]))"))
  /// Invariant 7: at most one SUCCEEDED attempt per Payment.
  @@unique([paymentId], map: "core_payment_transactions_one_succeeded_uq", where: { status: "SUCCEEDED" })
  @@index([paymentId], map: "core_payment_transactions_payment_id_idx")
  /// Operator Payments list: latest attempt of a Payment, and the gateway filter.
  @@index([paymentId, createdAt, id], map: "core_payment_transactions_payment_created_idx")
  @@index([gatewayId, paymentId], map: "core_payment_transactions_gateway_payment_idx")
  /// Operator Reviews list: keyset paging by the time the Review opened, inside one Organization.
  @@index([organizationId, reviewOpenedAt, id], map: "core_payment_transactions_org_review_opened_idx")
  @@map("core_payment_transactions")
}

/// Fields only in Phase 1: there is no write path. `id` is the refund key.
model Refund {
  id               String       @id @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  attemptId        String       @map("attempt_id") @db.Uuid
  /// CHECK amount > 0 in SQL.
  amount           Decimal      @db.Decimal(19, 4)
  status           RefundStatus
  providerRef      String?      @map("provider_ref")
  providerMetadata Json?        @map("provider_metadata")
  reason           String?
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attempt      PaymentTransaction @relation(fields: [attemptId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, id], map: "core_refunds_org_id_idx")
  @@index([attemptId], map: "core_refunds_attempt_id_idx")
  @@map("core_refunds")
}

// ---------------------------------------------------------------------------
// Infrastructure tables
// ---------------------------------------------------------------------------

/// Raw provider payloads, stored and never interpreted by Core.
model GatewayRawResponse {
  id             String           @id @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  attemptId      String           @map("attempt_id") @db.Uuid
  operation      GatewayOperation
  payload        Json
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attempt      PaymentTransaction @relation(fields: [attemptId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([attemptId, createdAt], map: "core_gateway_raw_responses_attempt_created_idx")
  @@map("core_gateway_raw_responses")
}

/// Idempotency-Key records for POST /payments (kept 24 hours). A key is
/// unique within an Organization, so two Organizations never share a record.
model IdempotencyKey {
  organizationId String   @map("organization_id") @db.Uuid
  key            String   @db.VarChar(255)
  requestHash    String   @map("request_hash")
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  paymentId      String?  @map("payment_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  payment      Payment?     @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([organizationId, key])
  @@index([expiresAt], map: "core_idempotency_keys_expires_at_idx")
  @@map("core_idempotency_keys")
}

/// Transactional outbox of Payment-level events. `id` is also the BullMQ job id.
model OutboxEvent {
  id             String          @id @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  eventType      OutboxEventType @map("event_type")
  paymentId      String          @map("payment_id") @db.Uuid
  payload        Json
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt    DateTime?       @map("published_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  payment      Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([id], map: "core_outbox_events_unpublished_idx", where: raw("(published_at IS NULL)"))
  @@index([publishedAt], map: "core_outbox_events_published_at_idx")
  @@index([organizationId, createdAt, id], map: "core_outbox_events_org_created_at_id_idx")
  @@map("core_outbox_events")
}

/// Verified gateway callbacks, stored before processing.
model WebhookInbox {
  id              String             @id @db.Uuid
  organizationId  String             @map("organization_id") @db.Uuid
  gatewayId       String             @map("gateway_id")
  /// Provider event id when present, otherwise SHA-256 of the raw body.
  dedupeKey       String             @map("dedupe_key")
  providerEventId String?            @map("provider_event_id")
  /// No foreign key: a callback may name an attempt Core does not know.
  attemptKey      String?            @map("attempt_key") @db.Uuid
  rawBody         Bytes              @map("raw_body")
  /// Allow-listed per plugin.
  headers         Json
  query           Json
  status          WebhookInboxStatus @default(RECEIVED)
  attempts        Int                @default(0)
  lockedAt        DateTime?          @map("locked_at") @db.Timestamptz(3)
  lastError       String?            @map("last_error")
  receivedAt      DateTime           @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt     DateTime?          @map("processed_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, gatewayId, dedupeKey], map: "core_webhook_inbox_org_gateway_dedupe_uq")
  @@index([lockedAt], map: "core_webhook_inbox_processing_locked_idx", where: { status: "PROCESSING" })
  @@index([receivedAt], map: "core_webhook_inbox_pending_received_idx", where: raw("(status = ANY (ARRAY['RECEIVED'::core_webhook_inbox_status, 'FAILED'::core_webhook_inbox_status]))"))
  @@index([organizationId, receivedAt, id], map: "core_webhook_inbox_org_received_at_idx")
  @@index([attemptKey], map: "core_webhook_inbox_attempt_key_idx")
  @@map("core_webhook_inbox")
}

/// Append-only audit trail, written in the same transaction as the change.
model StatusTransition {
  id             String                     @id @db.Uuid
  organizationId String                     @map("organization_id") @db.Uuid
  entityType     StatusTransitionEntityType @map("entity_type")
  entityId       String                     @map("entity_id") @db.Uuid
  /// Null when the entity is created.
  fromStatus     String?                    @map("from_status")
  toStatus       String                     @map("to_status")
  trigger        String
  actor          String
  /// The Role the acting User held; null for system and customer actors.
  actorRole      String?                    @map("actor_role")
  /// The acting User's name, kept so read models need not read Users.
  actorName      String?                    @map("actor_name")
  reason         String?
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([entityType, entityId, createdAt], map: "core_status_transitions_entity_idx")
  @@index([organizationId, createdAt, id], map: "core_status_transitions_org_created_at_id_idx")
  @@map("core_status_transitions")
}

/// One Organization's own account with one PaymentGateway (ADR 0007). Never
/// deleted once used. `credentialsCiphertext` is AES-256-GCM under the key
/// named by `credentialsKeyId`; both are null for a gateway without credentials
/// (`fake`). Credentials are never returned by any endpoint.
model GatewayConnection {
  id                    String   @id @db.Uuid
  organizationId        String   @map("organization_id") @db.Uuid
  gatewayId             String   @map("gateway_id")
  credentialsCiphertext String?  @map("credentials_ciphertext")
  credentialsKeyId      String?  @map("credentials_key_id")
  /// Bumped on every credentials replacement; part of the plugin cache key.
  credentialsVersion    Int      @default(1) @map("credentials_version")
  enabled               Boolean  @default(true)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, gatewayId], map: "core_gateway_connections_org_gateway_uq")
  @@map("core_gateway_connections")
}

// ---------------------------------------------------------------------------
// Checkout (chk_): Pricing Plans
// ---------------------------------------------------------------------------

enum PricingPlanStatus {
  ACTIVE
  ARCHIVED

  @@map("chk_pricing_plan_status")
}

/// What an Organization sells for a fixed Amount. Payments copy the Amount and
/// the name when they are created, so edits never touch them. `features` is an
/// ordered JSON array of `{ text, included }`, plain text only. An empty
/// `allowed_gateway_ids` means every enabled PaymentGateway. `amount > 0` and
/// the Payment Expiry range are CHECK constraints in the migration.
model PricingPlan {
  id                String            @id @db.Uuid
  organizationId    String            @map("organization_id") @db.Uuid
  name              String
  description       String
  features          Json
  amount            Decimal           @db.Decimal(19, 4)
  currency          String
  allowedGatewayIds String[]          @map("allowed_gateway_ids")
  successUrl        String?           @map("success_url")
  cancelUrl         String?           @map("cancel_url")
  expiryMinutes     Int               @map("expiry_minutes")
  status            PricingPlanStatus @default(ACTIVE)
  /// The User who last changed it, with their Role and name at that moment.
  updatedByUserId   String            @map("updated_by_user_id") @db.Uuid
  updatedByRole     String            @map("updated_by_role")
  updatedByName     String            @map("updated_by_name")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tables       PricingTablePlan[]

  @@index([organizationId, createdAt, id], map: "chk_pricing_plans_org_created_at_idx")
  @@map("chk_pricing_plans")
}

// ---------------------------------------------------------------------------
// Checkout (chk_): Pricing Tables
// ---------------------------------------------------------------------------

enum PricingTableTheme {
  light
  dark

  @@map("chk_pricing_table_theme")
}

enum PricingTableLanguage {
  vi
  en

  @@map("chk_pricing_table_language")
}

/// One to three Pricing Plans shown side by side on a host page, with a
/// simple look. Its Pricing Plans, in order, are `chk_pricing_table_plans`.
/// `main_color` is `#rrggbb` in lower case (CHECK in the migration).
model PricingTable {
  id              String               @id @db.Uuid
  organizationId  String               @map("organization_id") @db.Uuid
  name            String
  mainColor       String               @map("main_color")
  theme           PricingTableTheme
  language        PricingTableLanguage
  buttonText      String               @map("button_text")
  /// The User who last changed it, with their Role and name at that moment.
  updatedByUserId String               @map("updated_by_user_id") @db.Uuid
  updatedByRole   String               @map("updated_by_role")
  updatedByName   String               @map("updated_by_name")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @map("updated_at") @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  plans        PricingTablePlan[]

  @@index([organizationId, createdAt, id], map: "chk_pricing_tables_org_created_at_idx")
  @@map("chk_pricing_tables")
}

/// A Pricing Plan's place in a Pricing Table. At most one per table is
/// recommended (partial unique index). A Pricing Plan may sit
/// in several Pricing Tables, and cannot be deleted while it does.
model PricingTablePlan {
  pricingTableId String  @map("pricing_table_id") @db.Uuid
  pricingPlanId  String  @map("pricing_plan_id") @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  /// 0-based card order.
  position       Int
  recommended    Boolean @default(false)

  pricingTable PricingTable @relation(fields: [pricingTableId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  pricingPlan  PricingPlan  @relation(fields: [pricingPlanId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([pricingTableId, pricingPlanId], map: "chk_pricing_table_plans_pkey")
  @@unique([pricingTableId, position], map: "chk_pricing_table_plans_table_position_key")
  @@unique([pricingTableId], map: "chk_pricing_table_plans_one_recommended_key", where: { recommended: true })
  @@index([organizationId, pricingPlanId], map: "chk_pricing_table_plans_org_plan_idx")
  @@map("chk_pricing_table_plans")
}

// ---------------------------------------------------------------------------
// Webhooks (wh_): Webhook Endpoints, deliveries and their attempts
// ---------------------------------------------------------------------------

enum WebhookEndpointStatus {
  ENABLED
  DISABLED

  @@map("wh_endpoint_status")
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED

  @@map("wh_delivery_status")
}

/// A URL of an Organization's system that receives Webhooks. The signing
/// secret is AES-256-GCM under `secretKeyId` (shown in full once, then by
/// `secretPrefix`). Deleting sets `deletedAt`: deliveries keep their endpoint.
/// `updatedBy*` record who wrote it last (a Super Admin shows as the platform).
model WebhookEndpoint {
  id               String                @id @db.Uuid
  organizationId   String                @map("organization_id") @db.Uuid
  url              String
  /// Subscribed Payment Event kinds, such as `payment.succeeded`.
  eventKinds       String[]              @map("event_kinds")
  status           WebhookEndpointStatus @default(ENABLED)
  secretCiphertext String                @map("secret_ciphertext")
  secretKeyId      String                @map("secret_key_id")
  secretPrefix     String                @map("secret_prefix")
  /// The secret before the last roll (ticket 04): it still signs until
  /// `previousSecretExpiresAt`.
  previousSecretCiphertext String?   @map("previous_secret_ciphertext")
  previousSecretKeyId      String?   @map("previous_secret_key_id")
  previousSecretExpiresAt  DateTime? @map("previous_secret_expires_at") @db.Timestamptz(3)
  updatedByUserId  String                @map("updated_by_user_id") @db.Uuid
  updatedByRole    String                @map("updated_by_role")
  updatedByName    String                @map("updated_by_name")
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?             @map("deleted_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  deliveries   WebhookDelivery[]
  secretRolls  WebhookSecretRoll[]

  @@index([organizationId], map: "wh_endpoints_organization_id_idx")
  @@map("wh_endpoints")
}

/// One Payment Event to one Webhook Endpoint. `eventId` is the outbox event
/// id (stable across attempts and resends); `payload` is the envelope's
/// `data`, the Payment Event payload as Core wrote it.
model WebhookDelivery {
  id             String                @id @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  endpointId     String                @map("endpoint_id") @db.Uuid
  eventId        String                @map("event_id") @db.Uuid
  eventKind      String                @map("event_kind")
  eventCreatedAt DateTime              @map("event_created_at") @db.Timestamptz(3)
  paymentId      String?               @map("payment_id") @db.Uuid
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// When a `PENDING` delivery is due for its next attempt (null: now).
  nextAttemptAt  DateTime?             @map("next_attempt_at") @db.Timestamptz(3)
  /// Set while one worker makes an attempt; an old lock lost its worker.
  lockedAt       DateTime?             @map("locked_at") @db.Timestamptz(3)

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  endpoint     WebhookEndpoint          @relation(fields: [endpointId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attemptRows  WebhookDeliveryAttempt[]

  @@unique([eventId, endpointId], map: "wh_deliveries_event_endpoint_uq")
  @@index([organizationId, createdAt], map: "wh_deliveries_organization_created_idx")
  @@index([endpointId], map: "wh_deliveries_endpoint_id_idx")
  @@index([status, nextAttemptAt], map: "wh_deliveries_due_idx")
  @@map("wh_deliveries")
}

/// One HTTP POST of a delivery: when, the HTTP status (null when no answer),
/// how long it took, a truncated response body, and why it failed.
model WebhookDeliveryAttempt {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  deliveryId     String   @map("delivery_id") @db.Uuid
  attemptedAt    DateTime @map("attempted_at") @db.Timestamptz(3)
  succeeded      Boolean
  httpStatus     Int?     @map("http_status")
  durationMs     Int      @map("duration_ms")
  responseBody   String?  @map("response_body")
  error          String?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  delivery     WebhookDelivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([deliveryId, attemptedAt], map: "wh_delivery_attempts_delivery_idx")
  @@map("wh_delivery_attempts")
}

/// The audit log of signing secret rolls: who rolled an endpoint's secret,
/// when, and until when the previous secret stayed valid (null: at once).
model WebhookSecretRoll {
  id                      String    @id @db.Uuid
  organizationId          String    @map("organization_id") @db.Uuid
  endpointId              String    @map("endpoint_id") @db.Uuid
  rolledAt                DateTime  @map("rolled_at") @db.Timestamptz(3)
  previousSecretExpiresAt DateTime? @map("previous_secret_expires_at") @db.Timestamptz(3)
  rolledByUserId          String    @map("rolled_by_user_id") @db.Uuid
  rolledByRole            String    @map("rolled_by_role")
  rolledByName            String    @map("rolled_by_name")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  endpoint     WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([endpointId, rolledAt], map: "wh_secret_rolls_endpoint_idx")
  @@map("wh_secret_rolls")
}
