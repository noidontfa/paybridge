{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@paybridge/typescript-config/next.json",
  "compilerOptions": {
    "types": ["vitest/globals", "node", "@testing-library/jest-dom"],
    "paths": { "@/*": ["./src/*"] },
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "src", "e2e", "*.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
