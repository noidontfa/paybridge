# Console (Next.js) server-side configuration.
# Copy to `.env.local` (gitignored) and adjust. None of these reach the browser.

# Base URL of the PayBridge API that the BFF (/api/bff/internal/...) forwards to.
# Must NOT be the Console's own address. The API uses 9999 and `pnpm dev` here uses 8888.
CONSOLE_API_BASE_URL=http://localhost:9999

# Serve the API from in-process mocks instead of a real API. Development only;
# refused in a production build.
CONSOLE_API_MOCKS=false

# Mock mode only (no API, so no sign-in): who the Console says is signed in.
# With a real API the signed-in User comes from the sign-in page.
CONSOLE_OPERATOR_ID=operator
CONSOLE_OPERATOR_NAME=Operator
