# Shared dev defaults for the Console (committed). Personal overrides go in `.env.local`.
# See .env.example for what each variable does.
# The API (apps/api) listens on 3000; the Console dev server uses 3001 (see package.json).
CONSOLE_API_BASE_URL=http://localhost:3000
# Real API by default. Set CONSOLE_API_MOCKS=true in .env.local for in-process mocks (no backend).
CONSOLE_API_MOCKS=false
CONSOLE_OPERATOR_ID=operator
CONSOLE_OPERATOR_NAME=Operator
