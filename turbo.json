{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [".nvmrc"],
  "tasks": {
    "db:generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.spec.ts", "!**/*.test.ts", "!**/*.test.tsx", "!test/**", "!e2e/**"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["CONSOLE_API_BASE_URL", "CONSOLE_API_MOCKS"]
    },
    "dev": {
      "dependsOn": ["db:generate"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "db:generate"]
    },
    "lint": {
      "dependsOn": ["db:generate"]
    },
    "test": {
      "dependsOn": ["db:generate"]
    },
    "test:e2e": {
      "dependsOn": ["db:generate"],
      "cache": false
    },
    "@paybridge/console#test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    },
    "test:int": {
      "dependsOn": ["db:generate"],
      "cache": false,
      "passThroughEnv": ["TEST_DATABASE_NAME"]
    }
  }
}
